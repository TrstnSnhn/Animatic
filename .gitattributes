# Normalize source and documentation files across Windows/macOS/Linux.
* text=auto

/.gitattributes text eol=lf
/.gitignore text eol=lf

*.css text eol=lf
*.html text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.py text eol=lf
*.txt text eol=lf

*.jpeg binary
*.jpg binary
*.png binary
*.svg text eol=lf
*.webp binary

*.glb binary
*.keras filter=lfs diff=lfs merge=lfs -text
